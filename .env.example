# Copy to .env.local (git-ignored). NEVER prefix any of these with VITE_ (that would ship them to browsers).

# --- AI (optional) -----------------------------------------------------------
# Enables the AI safety briefing and the frame narrator. Without it the app still works:
# briefings are generated by deterministic rules from the same data.
# Restrict the key in Google Cloud / AI Studio (API restriction + quota) as defence in depth.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
# Hard cap on AI calls per UTC day across all users (cost-abuse protection).
GEMINI_DAILY_BUDGET=300

# --- NASA data ---------------------------------------------------------------
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ - enables satellite fire detections.
# NASA POWER and EONET need no key.
FIRMS_MAP_KEY="MY_FIRMS_MAP_KEY"

# Supplemental (non-NASA) free data: 16-day weather forecast, river discharge, elevation.
# Open-Meteo's free tier is for non-commercial use; set false to run on NASA data + USGS only.
ENABLE_OPEN_METEO=true

# --- Network / deployment ----------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Number of reverse proxies in front of this app (Cloud Run / Nginx / Cloudflare = 1). Needed for correct
# per-client rate limiting and HSTS. Leave 0 when directly exposed (X-Forwarded-* is then ignored).
TRUST_PROXY_HOPS=0
# Extra browser origins allowed to call /api (comma-separated). Same-origin always works.
ALLOWED_ORIGINS=""
# Where this app may be embedded. Default forbids framing (clickjacking protection).
# FRAME_ANCESTORS="'self' https://example.com"
APP_URL="MY_APP_URL"

# Contact e-mail added to upstream User-Agent (requested by Nominatim/NASA etiquette).
CONTACT_EMAIL=""
# Self-hosting a geocoder is recommended for heavy use (https only).
# GEOCODER_URL="https://nominatim.openstreetmap.org/reverse"

# --- Rate limits (per client IP per minute) ----------------------------------
RATE_API_PER_MIN=120
RATE_RISK_PER_MIN=20
RATE_BRIEF_PER_MIN=6
RATE_FRAME_PER_MIN=4
